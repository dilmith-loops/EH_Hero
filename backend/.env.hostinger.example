# ------------------------------------------------------------------------------
# Hostinger MySQL Database Configuration
# 1. In Hostinger hPanel, go to: Databases -> Management
# 2. Create a new MySQL Database (e.g. u123456789_eh_hero)
# 3. Fill in the DB_DATABASE, DB_USERNAME, and DB_PASSWORD below:
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_hostinger_database_name
DB_USERNAME=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
 
# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration
# Place your Gemini API key from Google AI Studio here (never hardcoded in Git)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
